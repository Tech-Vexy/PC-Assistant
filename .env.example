[TEMPLATE]
# Minimal config — most users only fill in the three keys below.
# Everything else has working defaults; the full option list lives in
# README "Advanced configuration". You can also set it all at
# http://localhost:3000/setup instead of editing this file.

# AssemblyAI (voice pipeline)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# AGENT_ID=  # filled automatically by `npm run up` / `npm run publish`

# Voice LLM: OpenRouter + free model by default — just add your key
# (get one at https://openrouter.ai/keys). No other LLM settings needed:
# base https://openrouter.ai/api/v1, model openrouter/free are baked in.
LLM_API_KEY=your_openrouter_api_key_here

# Computer Use vision loop (on by default) needs a Gemini key
# (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=3000
