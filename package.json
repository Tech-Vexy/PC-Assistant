{
  "name": "pc-voice-assistant",
  "version": "1.0.0",
  "description": "PC Personal Voice Assistant with AssemblyAI Voice Agent API and MCP servers",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "up": "node scripts/launch.js",
    "agent": "node agent.js",
    "wakeword": "node wakeword.js",
    "setup-agent": "node setup-agent.js",
    "publish": "node setup-agent.js",
    "setup": "node scripts/setup.js",
    "check-ffmpeg": "node scripts/check-ffmpeg.js",
    "tray": "node scripts/tray.js",
    "sign-manifest": "node -e \"import('./tools.js').then(async ({buildAllTools}) => (await import('./lib/security-extras.js')).signToolManifest(buildAllTools()).then(m => console.log('signed', m.sha256)))\"",
    "vet-tools": "node -e \"import('./tools.js').then(async ({buildAllTools}) => (await import('./lib/security-extras.js')).vetAllTools(buildAllTools()).then(r => { console.table(r); if (r.some(x => !x.ok)) process.exit(1); }))\"",
    "test": "node --test tests/security.test.js tests/perf.test.js tests/mcp-client.test.js tests/store.test.js tests/tools.test.js tests/server.test.js tests/setup-ui.test.js tests/launch.test.js tests/computer-use.test.js tests/memory.test.js tests/terminal.test.js tests/planner.test.js tests/agents.test.js",
    "dev": "concurrently \"npm run start\" \"npm run agent\""
  },
  "keywords": [
    "voice-assistant",
    "assemblyai",
    "gemini",
    "computer-use",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@google/genai": "^2.24.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-os-utils": "^1.3.7",
    "playwright": "^1.63.0",
    "screenshot-desktop": "^1.15.6",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
